package pages

import "fmt"

templ VideoEmptyView() {
	<div id="video-container" class="relative flex justify-center items-center w-full aspect-video mx-auto overflow-hidden border-t border-b bg-black/90">
		<span class="text-sm text-gray-500 font-mono">CHOOOOOSSESEEE FILEEE TO PLAYY</span>
		<span class="absolute top-3 left-4 text-xs text-gray-500 font-mono">🡑 Click here 🡑</span>
	</div>
}

templ VideoLoadingView(sessionID string) {
	<div
		id="video-container"
		hx-get={ fmt.Sprintf("/video/session/%s", sessionID) }
		hx-trigger="every 2s"
		hx-swap="outerHTML"
		class="flex justify-center items-center w-full pb-4 pt-6 relative max-h-full aspect-video mx-auto overflow-hidden border-t border-b bg-black/90"
	>
		<div id="video-player">
			<div class="flex flex-col items-center gap-2">
				<span class="loading loading-spinner loading-lg text-primary"></span>
				<span class="text-sm text-gray-400 font-mono">waito.............</span>
			</div>
		</div>
	</div>
}

templ VideoPlayingView(sessionID string) {
	<div
		id="video-container"
		hx-get={ fmt.Sprintf("/video/session/%s/keepalive", sessionID) }
		hx-trigger="every 10s"
		hx-swap="none"
		class="flex justify-center items-center w-full pb-4 pt-6 relative max-h-full aspect-video mx-auto overflow-hidden border-t border-b bg-black/90"
	>
		<video
			id="video-element"
			playsinline
			controls
			class="w-full h-full object-contain transform-gpu will-change-transform z-0 relative"
		></video>
		@InitVideoPlayer(fmt.Sprintf("/api/v1/video/session/%s/hls/stream/manifest.m3u8", sessionID))
	</div>
}

script InitVideoPlayer(url string) {
    let v = document.getElementById('video-element');
    if (Hls.isSupported()) {
        var h = new Hls({ shouldRetry: () => true, fragLoadingMaxRetry: 1000, fragLoadingRetryDelay: 1000,});
        h.loadSource(url)
        h.attachMedia(v)
        h.on('hlsError', (_, d) => d.fatal && h.startLoad());
    } else if (v.canPlayType('application/vnd.apple.mpegurl')) {
        v.src = url;
    }
}

package pages

import (
	"fmt"
	. "lim/internal/models"
)

func getPosterURL(path string) string {
	if path == "" {
		return ""
	}
	return "https://image.tmdb.org/t/p/w500" + path
}

templ gridHeader(text string) {
	<div class="border-b-2  pb-2 mb-6">
		<h1 class="text-2xl font-serif font-normal">{ text }</h1>
	</div>
}

templ pagination(Page, TotalPages uint) {
	// because of uint -> overflow negative
	{{ page := int(Page) }}
	<div class="flex justify-center items-center w-full py-4 my-4 border-t border-b text-xs font-mono">
		<div class="flex items-center gap-2">
			if Page > 1 {
				<a class="underline px-2 py-1">Prev</a>
			}
			for i := max(1,page-3); i <= min(max(7,page+3),int(TotalPages)); i++ {
				if i == page {
					<span class="font-bold text-sm px-2 py-1">
						<b>{ fmt.Sprintf("%d", i) }</b>
					</span>
				} else {
					<a class="underline px-2 py-1">
						{ fmt.Sprintf("%d", i) }
					</a>
				}
			}
			if Page < TotalPages {
				<a class="underline px-2 py-1">Next</a>
			}
		</div>
	</div>
}

templ mediaGrid(data []MediaItem) {
	<div class="grid grid-cols-4 sm:grid-cols-4 gap-4">
		for _, item := range data {
			@mediaCard(item)
		}
	</div>
}

templ mediaCard(item MediaItem) {
	<div
		id={ item.ID }
		class="border p-1 cursor-pointer group flex flex-col justify-between relative"
		title={ item.GetName() }
		hx-boost="true"
	>
		<a href={ fmt.Sprintf("/detail/%s/%d", item.MediaType, item.ID) } class="absolute inset-0 z-10" hx-boost="true" hx-target="#main">
			<span class="sr-only">{ item.Name }</span>
		</a>
		<div>
			<div class="relative w-full aspect-2/3 overflow-hidden">
				@image(item.PosterPath, item.Name)
			</div>
			<div class="pt-2 px-1">
				<h3 class="text-xs font-serif truncate group-hover:underline group-hover:font-bold">
					{ item.GetName() }
				</h3>
			</div>
		</div>
		<div class="p-1 flex items-center justify-between text-[10px] font-mono text-gray-600 dark:text-gray-400 mt-2 border-t border-gray-300 dark:border-gray-700 dark:group-hover:text-white group-hover:text-black">
			<span>{ item.GetDate() }</span>
			if item.MediaType != "" {
				<span class="uppercase">[{ item.MediaType }]</span>
			}
		</div>
	</div>
}

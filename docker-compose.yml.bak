services:
  api:
    build:
      context: ./
      dockerfile: Dockerfile
    ports:
      - "8081:8080"
      - "2345:2345"
    volumes:
      - ./:/app
    networks:
      - internal
  db:
    image: groonga/pgroonga:latest-alpine-16
    shm_size: 1g
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
      - ./database.sql:/docker-entrypoint-initdb.d/database.sql
      - ./stuff/TMDB_movie_dataset_v11.csv:/stuff/TMDB_movie_dataset_v11.csv
      - ./stuff/Torrents.csv:/stuff/Torrents.csv
      - ./stuff/torrent_match.csv:/stuff/torrent_match.csv
    command:
      - "postgres"
      - "-c"
      - "max_wal_size=4GB"
      - "-c"
      - "checkpoint_timeout=15min"
      - "-c"
      - "shared_buffers=3GB"
      - "-c"
      - "work_mem=64MB"
      - "-c"
      - "synchronous_commit=off"
      - "-c"
      - "effective_cache_size=6GB"
      - "-c"
      - "plan_cache_mode=force_custom_plan"
volumes:
  pgdata:
networks:
  internal:
    driver: bridge

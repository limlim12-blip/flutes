package pages

templ TorrentTester() {
	<div class="max-w-xl mx-auto p-6 bg-base-200 rounded-lg shadow-xl mt-10 flex flex-col gap-4">
		<h2 class="text-xl font-bold text-base-content">Torrent Stream Tester</h2>
		<form hx-post="/api/test-stream" hx-target="#video-container" hx-swap="innerHTML" class="flex flex-col gap-3">
			<input
				type="text"
				name="magnet"
				placeholder="Paste Magnet Link Here..."
				class="input input-bordered w-full text-sm"
				required
			/>
			<button type="submit" class="btn btn-primary">Start Stream</button>
		</form>
		<!-- Target container where the video player will load -->
		<div id="video-container" class="w-full mt-4">
			<div class="aspect-video bg-black rounded flex items-center justify-center text-neutral-content text-sm">
				Video player will appear here...
			</div>
		</div>
	</div>
}

// Fragment returned by your Go backend after submitting the form
templ VideoPlayer(streamURL string) {
	<div class="flex flex-col gap-2">
		<video
			controls
			autoplay
			class="w-full aspect-video bg-black rounded-lg shadow-inner"
		>
			<source src={ streamURL } type="video/mp4"/>
			Your browser does not support the video tag.
		</video>
		<p class="text-xs text-base-content/60 truncate">Streaming from: { streamURL }</p>
	</div>
}
